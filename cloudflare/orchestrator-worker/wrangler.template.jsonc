{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "formula-do-gol-orchestrator",
  "main": "src/index.js",
  "compatibility_date": "2026-09-03",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "orchestrator.formuladogol.com.br",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": [
      "__ORCHESTRATOR_CRON__"
    ]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "ORCHESTRATOR_MODE": "__ORCHESTRATOR_MODE__",
    "ORCHESTRATOR_VERSION": "__ORCHESTRATOR_VERSION__",
    "SITE_BASE": "https://formuladogol.com.br",
    "GITHUB_REPOSITORY": "LAERCIOREHEM/formuladogol",
    "GITHUB_BRANCH": "main",
    "CONTINENTAL_GUARD_FINGERPRINT": "__CONTINENTAL_GUARD_FINGERPRINT__"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ORCH_STATE",
        "class_name": "OrchestratorState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "OrchestratorState"
      ]
    }
  ]
}
