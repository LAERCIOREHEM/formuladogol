{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "formula-do-gol-orchestrator",
  "main": "src/index.js",
  "compatibility_date": "2026-09-03",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "orchestrator.formuladogol.com.br",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "ORCHESTRATOR_MODE": "__ORCHESTRATOR_MODE__",
    "ORCHESTRATOR_VERSION": "1.0.0",
    "SITE_BASE": "https://formuladogol.com.br",
    "GITHUB_REPOSITORY": "LAERCIOREHEM/formuladogol",
    "GITHUB_BRANCH": "main"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ORCH_STATE",
        "class_name": "OrchestratorState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "OrchestratorState"
      ]
    }
  ]
}
