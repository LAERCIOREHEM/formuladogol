{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "formula-do-gol-push",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "push.formuladogol.com.br",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "formula-do-gol-push",
      "database_id": "__D1_DATABASE_ID__"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PUSH_STATE",
        "class_name": "PushState"
      },
      {
        "name": "SPORTS_MONITOR",
        "class_name": "SportsMonitor"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "PushState"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "SportsMonitor"
      ]
    }
  ],
  "ratelimits": [
    {
      "name": "PUBLIC_RATE_LIMITER",
      "namespace_id": "260901301",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "PUSH_QUEUE",
        "queue": "formula-do-gol-push-delivery"
      }
    ],
    "consumers": [
      {
        "queue": "formula-do-gol-push-delivery",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 8,
        "max_concurrency": 5,
        "retry_delay": 15
      }
    ]
  }
}
