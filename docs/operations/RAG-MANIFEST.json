{
  "schema_version": 2,
  "production_rag_enabled": true,
  "purpose": "RAG operacional em produção para diagnóstico/contexto via índice local determinístico; nunca autoridade de fatos esportivos.",
  "collections": [
    "docs/operations/CONTRACTS.md",
    "docs/operations/runbooks/SPORTING-INTEGRITY.md",
    "docs/operations/incidents/*.md",
    "docs/operations/R10R16-ROLLBACK.md",
    "docs/operations/runbooks/POSTGAME-FACTUAL-INTEGRITY.md",
    "docs/operations/README.md",
    "docs/operations/runbooks/OPS-INTELLIGENCE-RAG-MCP.md"
  ],
  "authority_rules": {
    "placar": "structured_source_only",
    "classificacao": "deterministic_only",
    "probabilidades": "deterministic_only",
    "publico_renda": "match_identity_plus_factual_integrity_plus_verified_corrections",
    "rag": "diagnosis_and_context_only"
  },
  "runtime": {
    "name": "fdg-ops-rag",
    "version": 1,
    "index_url": "/dados-br/ops-rag-index.json",
    "retrieval": "deterministic_bm25_lexical",
    "generation": "mcp_host_model",
    "external_ai_calls_per_retrieval": 0,
    "web_search_calls_per_retrieval": 0,
    "critical_path": false,
    "fail_open": true
  },
  "mcp": {
    "enabled": true,
    "name": "formula-do-gol-ops",
    "version": "1.0.0",
    "endpoint": "https://push.formuladogol.com.br/mcp",
    "protocol_version": "2026-07-28",
    "legacy_compatibility": true,
    "read_only": true,
    "writes": false
  }
}
